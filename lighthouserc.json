{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8099/ar/",
        "http://localhost:8099/en/",
        "http://localhost:8099/ar/p/support-a-daiya",
        "http://localhost:8099/en/p/support-a-daiya"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }],
        "categories:performance": ["error", { "minScore": 0.82, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2800, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 450, "aggregationMethod": "median-run" }],
        "uses-responsive-images": "off",
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800, "aggregationMethod": "median-run" }],
        "interactive": ["warn", { "maxNumericValue": 3800, "aggregationMethod": "median-run" }],
        "speed-index": ["warn", { "maxNumericValue": 3400, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}

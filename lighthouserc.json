{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs",
      "startServerReadyPattern": "listening",
      "url": ["http://localhost:4320/ar/", "http://localhost:4320/ar/p/smart-study", "http://localhost:4320/ar/p/science-stars-book"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new", "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}

{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "store-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "ta",
      "i18n": {
        "sourceLocale": { "code": "ar", "subPath": "ar" },
        "locales": {
          "en": { "translation": "src/locales/messages.en.xlf", "subPath": "en" }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles/fonts.css", "src/styles/tokens.css", "src/styles/base.css", "src/styles/store.css"],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "ssr": false,
            "localize": true,
            "security": { "allowedHosts": [] },
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.production.ts" }
              ],
              "budgets": [
                { "type": "initial", "maximumWarning": "350kB", "maximumError": "500kB" },
                { "type": "anyComponentStyle", "maximumWarning": "6kB", "maximumError": "8kB" }
              ],
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all"
            },
            "local": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.local.ts" }
              ]
            },
            "ci": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.ci.ts" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "ar": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["ar"]
            },
            "en": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["en"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "store-web:build:production" },
            "development": { "buildTarget": "store-web:build:development" },
            "ar": { "buildTarget": "store-web:build:ar" },
            "en": { "buildTarget": "store-web:build:en" }
          },
          "defaultConfiguration": "ar"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": { "buildTarget": "store-web:build:development" }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": { "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"] }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "store-web:build:development",
            "setupFiles": ["src/test-setup.ts"]
          }
        }
      }
    }
  }
}

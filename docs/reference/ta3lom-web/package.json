{
  "name": "ta3lom",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "node scripts/dev-all.mjs",
    "postinstall": "node scripts/relax-ng-node-gate.mjs",
    "prebuild": "node scripts/relax-ng-node-gate.mjs && node scripts/routes.mjs",
    "build": "ng build && node scripts/postbuild.mjs && node scripts/check-deploy-output.mjs && node scripts/check-csp.mjs && node scripts/check-bundle-budget.mjs",
    "build:ci": "node scripts/routes.mjs && ng build --configuration production,ci && node scripts/postbuild.mjs && node scripts/check-deploy-output.mjs && node scripts/check-csp.mjs && node scripts/check-bundle-budget.mjs",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" && node scripts/contrast-check.mjs",
    "test": "ng test",
    "e2e": "playwright test",
    "a11y": "node scripts/a11y.mjs && A11Y_THEME=dark node scripts/a11y.mjs",
    "stub-api": "node scripts/stub-api.mjs",
    "types:pull": "node scripts/types-pull.mjs",
    "nav:check": "node scripts/nav-check.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/aria": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/localize": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/ssr": "^22.1.7",
    "@toast-ui/editor": "^3.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@toast-ui/editor": {
      "dompurify": "^3.4.13"
    }
  }
}

# Store web runtime (container image, deploy/README.md). Serves the static build from /srv/site as a non-root user on
# :8080, plain HTTP: TLS is terminated by the shared VPS edge Caddy (TLS_MODE=edge, the only mode). The edge sends HSTS
# on the production names (owner M-8). TLS_MODE=direct was removed (review 06 L-6): non-root, read-only, no data volume
# and no NET_BIND_SERVICE cannot serve :443.
{
	admin off
	persist_config off
	auto_https disable_redirects
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv/site
	encode zstd gzip

	# Security headers (deploy/caddy-headers.conf) + the build's CSP and per-environment headers (generated at build,
	# scripts/gen-csp.mjs: csp.conf, env.conf — staging adds X-Robots-Tag: noindex, nofollow).
	import /etc/caddy/headers.conf
	import /etc/caddy/csp.conf
	import /etc/caddy/env.conf

	# E-2: order pages carry the order's status token in the link — never leak it in a Referer. Here, not in headers.conf:
	# that file is imported again in handle_errors, where a second @orders definition is an error.
	@orders path /ar/orders/* /en/orders/*
	# Deferred (">"): applied when the response is written, after the shared block — else that block wins.
	header @orders >Referrer-Policy "no-referrer"

	# Liveness: static, never touches the API.
	handle /healthz {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		respond "ok" 200
	}

	# The bare domain → Arabic (Arabic first).
	@root path /
	redir @root /ar/ 302

	# Apple Pay domain association (Moyasar hosted page): no extension, so the type is set here; the owner replaces the
	# file, so it revalidates. Deferred (">") so file_server's default type does not win.
	@applepay path /.well-known/apple-developer-merchantid-domain-association
	header @applepay >Content-Type "text/plain; charset=utf-8"

	# Build stamp: always fresh.
	@version path /version.json
	header @version Cache-Control "no-store"

	# Cache: fingerprinted assets for a year; HTML (incl. index.csr.html), robots and sitemap revalidate every time.
	# Review 04 S-7: the build's hashes are mixed case with `_` and `-` (lazy chunks such as chunk-Bu-ojct4.js).
	@hashed path_regexp hashed \-[A-Za-z0-9_-]{8}\.(js|css|woff2|woff|ttf|svg|png|jpg|webp|avif)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html path *.html */ /robots.txt /sitemap.xml
	header @html Cache-Control "no-cache"

	# Client-rendered routes (cart, checkout, login, orders, account, admin, and projects published after the build)
	# get the locale's client shell, status 200 — only when no prerendered file exists.
	@client {
		path_regexp client ^/(ar|en)/(cart|checkout|login|orders/[^/]+|account(/.*)?|admin(/.*)?|p/[a-z0-9-]+)/?$
		not file {path}/index.html
	}
	handle @client {
		header Cache-Control "no-cache"
		rewrite * /{re.client.1}/index.csr.html
		file_server
	}

	# Everything else (prerendered pages without a trailing slash such as /ar and /ar/p/<slug>, non-hashed assets,
	# favicons): revalidate. `?` = only when no earlier rule set it, so the @hashed immutable rule wins (review 06 D-3).
	handle {
		header ?Cache-Control "no-cache"
		try_files {path} {path}/index.html
		file_server
	}

	# Unknown paths: real 404 status. Inside a locale the client shell renders the app's own not-found page (with the
	# chrome and a noindex); elsewhere the static, script-free deploy/404.html.
	handle_errors 404 {
		# The security headers again: the error path is a separate route (review 06 L-1).
		import /etc/caddy/headers.conf
		import /etc/caddy/csp.conf
		import /etc/caddy/env.conf
		header Cache-Control "no-cache"
		@ar path /ar/*
		@en path /en/*
		handle @ar {
			rewrite * /ar/index.csr.html
			file_server
		}
		handle @en {
			rewrite * /en/index.csr.html
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}
